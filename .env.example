# StackSketch settings. Copy this file to .env in the same folder (the repo root)
# and fill in what you need; .env is gitignored. Variables already set in your
# shell win over this file. Restart `npm run dev` after editing.

# --- AI layer (read by the API) -------------------------------------------------
# Without a key the reviewer runs its rule checks only. With one you also get
# reworded findings, judgement calls, Idea -> architecture, AI flow narration
# and room chat.

# OpenRouter: one key for many models, including cheap ones for testing.
# Create a key at openrouter.ai under Settings > API Keys.
OPENROUTER_API_KEY=

# Or Claude directly, through the Anthropic API (or sign in with `ant auth login`).
# ANTHROPIC_API_KEY=

# Which to use when both are configured: openrouter or anthropic.
# By default OpenRouter is used whenever OPENROUTER_API_KEY is set.
# STACKSKETCH_PROVIDER=openrouter

# The model. Defaults: google/gemini-2.5-flash-lite on OpenRouter, claude-opus-5-5
# on Anthropic. Any OpenRouter model id works if the model supports structured
# outputs; other low-cost ones: openai/gpt-4.1-nano, deepseek/deepseek-v4.1-flash,
# mistralai/mistral-small-3.2-24b-instruct.
# STACKSKETCH_MODEL=google/gemini-2.5-flash-lite

# Thinking effort for Claude: low, medium or high. Not used with OpenRouter.
# STACKSKETCH_EFFORT=medium

# Uncomment to force rules only, even with a key.
# STACKSKETCH_LLM=off

# --- Sync server (defaults shown) -------------------------------------------------

# WebSocket port of the sync server.
# PORT=1234
# Where the sync server reaches the API.
# API_URL=http://127.0.0.1:8000
# Folder for the SQLite database, relative to apps/sync.
# DATA_DIR=./data
# How long the reviewer waits after edits stop, and how often it asks the AI.
# REVIEW_DEBOUNCE_MS=1200
# REFINE_DEBOUNCE_MS=4000
# REFINE_MIN_INTERVAL_MS=15000

# The web app's own settings (NEXT_PUBLIC_SYNC_URL, API_URL) go in apps/web/.env.local;
# see apps/web/.env.example.
